<Page x:Class="Strela_Sanatorii.Pages.PrescriptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox x:Name="cmbGuest"
                      Width="250"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="Фильтр по гостю"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="Id"
                      SelectionChanged="Filter_Changed"
                      Margin="0,0,20,0"/>

            <ComboBox x:Name="cmbStatus"
                      Width="150"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="Статус"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Назначено"/>
                <ComboBoxItem Content="В процессе"/>
                <ComboBoxItem Content="Выполнено"/>
                <ComboBoxItem Content="Отменено"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица назначений -->
        <DataGrid x:Name="PrescriptionsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Гость" Binding="{Binding GuestName}" Width="200"/>
                <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis}" Width="*"/>
                <DataGridTextColumn Header="Дата назначения" Binding="{Binding CreatedAt, StringFormat=g}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Открыть"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="Open_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Page>
