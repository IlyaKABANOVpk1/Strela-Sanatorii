<Page x:Class="Strela_Sanatorii.Pages.ServicesListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="ServicesListPage"
      Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="20">

        <!-- Верхняя панель с кнопками -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Добавить" Style="{StaticResource MaterialDesignRaisedButton}" Click="AddService_Click"/>
            <Button Content="Удалить" Style="{StaticResource MaterialDesignRaisedButton}" Click="DeleteService_Click"/>
            <Button Content="Редактировать" Style="{StaticResource MaterialDesignRaisedButton}" Click="EditService_Click"/>
        </StackPanel>

        <!-- Таблица услуг -->
        <DataGrid x:Name="ServicesGrid"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  Height="400">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Начало работы" Binding="{Binding WorkStart}" Width="100"/>
                <DataGridTextColumn Header="Конец работы" Binding="{Binding WorkEnd}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Page>
