<Page x:Class="Strela_Sanatorii.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">

            <TextBox x:Name="txtSearch"
                     Width="250"
                     Margin="0,0,10,0"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Поиск (логин)"
                     TextChanged="Search_TextChanged"/>

            <Button Content="Добавить пользователя"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="AddUser_Click"
                    Margin="0,0,20,0"/>

            <!-- Пагинация -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" Width="30" Click="PrevPage_Click" x:Name="btnPrev"/>
                <TextBlock x:Name="txtPageInfo" Text="1 / 1" Margin="10,0" VerticalAlignment="Center"/>
                <Button Content="▶" Width="30" Click="NextPage_Click" x:Name="btnNext"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="UsersGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="200"/>

                <!-- Кнопка удаления -->
                <DataGridTemplateColumn Header="Действия" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Удалить"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="Red"
                                    Click="DeleteUser_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Page>
