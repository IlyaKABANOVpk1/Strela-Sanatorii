<Page x:Class="Strela_Sanatorii.Pages.NurseSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Выполнение назначений врача"
                       FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <ComboBox x:Name="cmbStatus"
                      Width="150"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="Фильтр по статусу"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Назначено"/>
                <ComboBoxItem Content="Подтверждено"/>
                <ComboBoxItem Content="Выполнено"/>
            </ComboBox>
        </StackPanel>

        <!-- Таблица назначений -->
        <DataGrid x:Name="NurseGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Гость" Binding="{Binding GuestName}" Width="200"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ScheduledDate, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Время" Binding="{Binding ScheduledTime}" Width="80"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis}" Width="200"/>
                <DataGridTemplateColumn Header="Действия" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Подтвердить"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="Confirm_Click"/>
                                <Button Content="Выполнено"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="Complete_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Page>
