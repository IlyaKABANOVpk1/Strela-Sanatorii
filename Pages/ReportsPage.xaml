<Page x:Class="Strela_Sanatorii.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <TabControl x:Name="MainTabControl">

            <TabItem Header="Загрузка номеров">
                <DataGrid x:Name="dgLoad"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Смена" Binding="{Binding ShiftName}" Width="*"/>
                        <DataGridTextColumn Header="Всего мест" Binding="{Binding Total}" Width="120"/>
                        <DataGridTextColumn Header="Занято мест" Binding="{Binding Booked}" Width="100"/>
                        <DataGridTextColumn Header="Свободно мест" Binding="{Binding Free}" Width="100"/>
                        <DataGridTextColumn Header="Загрузка %" Binding="{Binding Percent}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Доходы по услугам">
                <DataGrid x:Name="dgIncome"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Посещаемость услуг">
                <DataGrid x:Name="dgVisits"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="Всего записей" Binding="{Binding Total}" Width="120"/>
                        <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid}" Width="100"/>
                        <DataGridTextColumn Header="Не оплачено" Binding="{Binding NotPaid}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Отчёт по смене">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" 
                                Orientation="Horizontal" 
                                Margin="0,0,0,15">
                        <ComboBox x:Name="cmbReportShift"
                                  Width="250"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  materialDesign:HintAssist.Hint="Выберите смену"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="ReportShift_Changed"/>
                    </StackPanel>

                    <DataGrid x:Name="dgShiftReport"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="100"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                            <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="100"/>
                            <DataGridTextColumn Header="Занято мест" Binding="{Binding Occupied}" Width="100"/>
                            <DataGridTextColumn Header="Гости" Binding="{Binding GuestNames}" Width="*"/>
                            <DataGridTextColumn Header="Пакет услуг" Binding="{Binding PackageName}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Экспорт в CSV"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="ExportCsv_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
