<Page x:Class="Strela_Sanatorii.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <TabControl Style="{StaticResource MaterialDesignTabControl}">

            <TabItem Header="Загрузка номеров">
                <DataGrid x:Name="dgLoad"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Смена" Binding="{Binding ShiftName}" Width="*"/>
                        <DataGridTextColumn Header="Всего номеров" Binding="{Binding Total}" Width="120"/>
                        <DataGridTextColumn Header="Занято" Binding="{Binding Booked}" Width="100"/>
                        <DataGridTextColumn Header="Свободно" Binding="{Binding Free}" Width="100"/>
                        <DataGridTextColumn Header="Загрузка %" Binding="{Binding Percent}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Доходы по услугам">
                <DataGrid x:Name="dgIncome"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Посещаемость услуг">
                <DataGrid x:Name="dgVisits"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="Всего записей" Binding="{Binding Total}" Width="120"/>
                        <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid}" Width="100"/>
                        <DataGridTextColumn Header="Не оплачено" Binding="{Binding NotPaid}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
