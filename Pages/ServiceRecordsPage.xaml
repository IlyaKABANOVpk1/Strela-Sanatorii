<Page x:Class="Strela_Sanatorii.Pages.ServiceRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="ServiceRecordsPage"
      Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="30" Width="350">

        <ComboBox x:Name="cmbClients"
                  DisplayMemberPath="FullName"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="Клиент"
                  Margin="0,0,0,15"/>

        <ComboBox x:Name="cmbServices"
                  DisplayMemberPath="Name"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="Услуга"
                  Margin="0,0,0,15"
                  SelectionChanged="cmbServices_SelectionChanged"/>

        <DatePicker x:Name="dpDate"
                    Margin="0,0,0,15"
                    SelectedDateChanged="dpDate_SelectedDateChanged"/>

        <ComboBox x:Name="cmbTimeSlots"
                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                  materialDesign:HintAssist.Hint="Время"
                  Margin="0,0,0,20"/>

        <Button Content="Записать"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="Save_Click"/>
    </StackPanel>
</Page>
