<Page x:Class="Strela_Sanatorii.Pages.GuestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch"
                     Width="300"
                     Margin="0,0,10,0"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Поиск (Фамилия, Имя, табельный)"
                     TextChanged="Search_TextChanged"/>

            <Button Content="Добавить"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="AddGuest_Click"
                    Margin="0,0,10,0"/>

            <Button Content="Редактировать"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="EditGuest_Click"
                    Margin="0,0,10,0"/>

            <Button Content="Удалить"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="DeleteGuest_Click"
                    Margin="0,0,20,0"/>

            <!-- Пагинация -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="◀" Width="30" Click="PrevPage_Click" x:Name="btnPrev"/>
                <TextBlock x:Name="txtPageInfo" Text="1 / 1" Margin="10,0" VerticalAlignment="Center"/>
                <Button Content="▶" Width="30" Click="NextPage_Click" x:Name="btnNext"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="GuestsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                <DataGridTextColumn Header="Табельный №" Binding="{Binding PersonnelNumber}" Width="120"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=d}" Width="120"/>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</Page>
