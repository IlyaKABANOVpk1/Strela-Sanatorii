<Page x:Class="Strela_Sanatorii.Pages.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <StackPanel Margin="20">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="Добавить"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Add_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Редактировать"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Edit_Click"
                    Margin="0,0,10,0"/>
            <Button Content="Удалить"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Delete_Click"/>
        </StackPanel>

        <DataGrid x:Name="RoomsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding RoomCategory.Name}" Width="*"/>
                <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

    </StackPanel>
</Page>
