<Page x:Class="Strela_Sanatorii.Pages.BookingGridPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}"
      Title="Шахматка бронирования">

    <DockPanel>

        <!-- Верхняя панель: Выбор смены -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20" VerticalAlignment="Center">
            <TextBlock Text="Выберите смену:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbShifts" Width="200" Margin="0,0,20,0"/>
            <Button Content="Обновить" Style="{StaticResource MaterialDesignRaisedButton}" Click="RefreshGrid"/>
        </StackPanel>

        <!-- Сетка номеров -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="RoomsGrid" Rows="0" Columns="5" Margin="20" HorizontalAlignment="Stretch"/>
        </ScrollViewer>

    </DockPanel>
</Page>
