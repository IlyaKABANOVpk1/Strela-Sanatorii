<Page x:Class="Strela_Sanatorii.Pages.DoctorGuestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}">

    <DockPanel Margin="20">

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <ComboBox x:Name="cmbShift"
                      Width="250"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="Фильтр по смене"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="Shift_Changed"
                      Margin="0,0,20,0"/>

            <TextBox x:Name="txtSearch"
                     Width="300"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Поиск (ФИО, табельный)"
                     TextChanged="Search_TextChanged"/>
        </StackPanel>

        <!-- Таблица гостей -->
        <DataGrid x:Name="GuestsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource MaterialDesignDataGrid}">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="120"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="150"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="100"/>
                <DataGridTextColumn Header="Табельный №" Binding="{Binding PersonnelNumber}" Width="120"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=d}" Width="120"/>
                <DataGridTemplateColumn Header="Действия" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Назначить лечение"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Click="Prescribe_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Page>
