<Window x:Class="Strela_Sanatorii.Windows.RoomCategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Категория номера"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <materialDesign:Card Padding="25" materialDesign:ElevationAssist.Elevation="Dp8">
            <StackPanel>
                <TextBlock Text="Данные категории"
                           FontSize="18" FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <TextBox x:Name="txtName"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Название категории *"
                         Margin="0,0,0,15"/>

                <TextBox x:Name="txtDescription"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Описание"
                         Margin="0,0,0,15"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="60"/>

                <TextBox x:Name="txtBasePrice"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         materialDesign:HintAssist.Hint="Базовая цена за смену *"
                         Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Margin="0,0,10,0"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Click="Cancel_Click"/>
                    <Button Content="Сохранить"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
