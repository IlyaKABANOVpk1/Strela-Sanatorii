<Window x:Class="Strela_Sanatorii.Windows.EvictionCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Справка о выселении"
        Height="700" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Справка о выселении гостя"
                   FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" Grid.Row="0"/>

        <!-- Печатная форма -->
        <Border Grid.Row="1" 
                BorderBrush="#BDBDBD" 
                BorderThickness="1" 
                Background="White"
                Padding="30">
            <StackPanel x:Name="PrintPanel">

                <TextBlock Text="ИС «СТРЕЛА»"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Профилакторий ПО «Стрела»"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Opacity="0.6"
                           Margin="0,0,0,30"/>

                <TextBlock Text="СПРАВКА О ВЫСЕЛЕНИИ"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ФИО гостя:" FontWeight="Bold" Grid.Row="0" Grid.Column="0"/>
                    <TextBlock x:Name="txtFullName" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Табельный номер:" FontWeight="Bold" Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtPersonnelNumber" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>

                    <TextBlock Text="Номер комнаты:" FontWeight="Bold" Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtRoomNumber" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>

                    <TextBlock Text="Смена:" FontWeight="Bold" Grid.Row="3" Grid.Column="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtShiftName" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/>

                    <TextBlock Text="Дата заезда:" FontWeight="Bold" Grid.Row="4" Grid.Column="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtCheckInDate" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"/>

                    <TextBlock Text="Дата выселения:" FontWeight="Bold" Grid.Row="5" Grid.Column="0" Margin="0,8,0,0"/>
                    <TextBlock x:Name="txtCheckOutDate" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"/>
                </Grid>

                <TextBlock Text="Оказанные услуги:"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,10,0,10"/>

                <DataGrid x:Name="dgServices"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          BorderBrush="#BDBDBD"
                          BorderThickness="1"
                          Margin="0,0,0,20">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat=C}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Separator Margin="0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="ИТОГО:" FontWeight="Bold" FontSize="14"/>
                    <TextBlock x:Name="txtTotalAmount" FontWeight="Bold" FontSize="14" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Подпись врача: _________________"
                           Margin="0,40,0,0"/>
                <TextBlock Text="Подпись медработника: _________________"
                           Margin="0,15,0,0"/>
                <TextBlock Text="Дата составления: _________________"
                           Margin="0,15,0,0"/>

            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Закрыть"
                    Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Close_Click"/>
            <Button Content="🖨️ Печать"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Print_Click"/>
        </StackPanel>
    </Grid>
</Window>
