<Window x:Class="Strela_Sanatorii.Windows.ServiceEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Редактировать услугу" Height="350" Width="350"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <StackPanel>
            <TextBox x:Name="txtName" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Название услуги" Margin="0,0,0,15"/>
            <TextBox x:Name="txtPrice" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Цена" Margin="0,0,0,15"/>
            <TextBox x:Name="txtWorkStart" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Время начала работы (например 10:00)" Margin="0,0,0,15"/>
            <TextBox x:Name="txtWorkEnd" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Время окончания работы (например 17:00)" Margin="0,0,0,25"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Margin="0,0,10,0" Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
