<Window x:Class="Strela_Sanatorii.Windows.PackageAddonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Дополнить пакет услуг"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Текущий пакет:"
                   FontWeight="Bold"
                   Margin="0,0,0,5"/>
        <TextBlock x:Name="txtCurrentPackage"
                   Grid.Row="1"
                   Margin="0,0,0,15"
                   Opacity="0.7"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Добавить услуги:"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <ComboBox x:Name="cmbService"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                      materialDesign:HintAssist.Hint="Услуга"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      Margin="0,0,0,10"/>

            <TextBox x:Name="txtQuantity"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     materialDesign:HintAssist.Hint="Количество"
                     Text="1"
                     Margin="0,0,0,10"/>

            <Button Content="Добавить в пакет"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="AddAddon_Click"
                    HorizontalAlignment="Left"/>

            <DataGrid x:Name="AddonsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Height="150"
                      Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Total, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Отмена"
                    Margin="0,0,10,0"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить дополнения"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
