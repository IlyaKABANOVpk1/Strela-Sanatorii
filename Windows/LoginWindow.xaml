<Window x:Class="Strela_Sanatorii.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Авторизация — ИС «Стрела»"
        Height="520" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        ResizeMode="NoResize">

    <Grid>

        <!-- ФОН -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A237E" Offset="0"/>
                <GradientStop Color="#3F51B5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- КАРТОЧКА -->
        <materialDesign:Card Width="420"
                             Padding="40"
                             UniformCornerRadius="20"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             materialDesign:ElevationAssist.Elevation="Dp8">

            <StackPanel>

                <!-- ИКОНКА -->
                <materialDesign:PackIcon Kind="ShieldAccount"
                                         Width="70"
                                         Height="70"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                <!-- ЗАГОЛОВОК -->
                <TextBlock Text="ИС «СТРЕЛА»"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock Text="Профилакторий"
                           FontSize="14"
                           Opacity="0.6"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- ПОДПИСЬ ЛОГИН -->
                <TextBlock Text="Логин:"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,5"
                           Opacity="0.7"/>

                <!-- ЛОГИН -->
                <TextBox x:Name="txtLogin"
                         materialDesign:HintAssist.Hint="Введите логин"
                         Margin="0,0,0,20"
                         FontSize="16"
                         Padding="10"
                         materialDesign:TextFieldAssist.HasClearButton="True"/>

                <!-- ПОДПИСЬ ПАРОЛЬ -->
                <TextBlock Text="Пароль:"
                           FontSize="12"
                           FontWeight="Bold"
                           Margin="0,0,0,5"
                           Opacity="0.7"/>

                <!-- ПАРОЛЬ -->
                <PasswordBox x:Name="txtPassword"
                             materialDesign:HintAssist.Hint="Введите пароль"
                             Margin="0,0,0,30"
                             FontSize="16"
                             Padding="10"/>

                <!-- КНОПКА -->
                <Button x:Name="btnLogin"
                        Content="ВОЙТИ"
                        Height="45"
                        FontSize="14"
                        FontWeight="Bold"
                        Click="btnLogin_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>

                <!-- ОШИБКА -->
                <TextBlock x:Name="lblError"
                           Foreground="#D32F2F"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

              

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
